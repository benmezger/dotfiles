{
  "apiKeyHelper": "{{ onepasswordRead (join "/" (list .onepassword.work_env "claude_api_key_helper_command")) }}",
  "theme": "auto",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_BASE_URL": "{{ onepasswordRead (join "/" (list .onepassword.work_env "claude_anthropic_base_url")) }}",
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "3600000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Bash(chown -R:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.session_id) | \\(now | strftime(\"%Y-%m-%d %H:%M\"))\"' >> .claude-sessions.log"
          }
        ]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh", "padding": 2 }
}
